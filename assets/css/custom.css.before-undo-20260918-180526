/* ==================================================
   MODERN FRONTEND ENHANCEMENTS
   ================================================== */

/* Smooth entrance animations */
@keyframes rmh-fade-up {
    from {
        opacity: 0;
        transform: translateY(24px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes rmh-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes rmh-scale-in {
    from {
        opacity: 0;
        transform: scale(0.96);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* Hero entrance animation */
.rmh-home-hero {
    animation: rmh-fade-up 0.7s ease-out;
}

.rmh-home-hero__content > * {
    animation: rmh-fade-up 0.6s ease-out backwards;
}

.rmh-home-hero__content > *:nth-child(1) { animation-delay: 0.05s; }
.rmh-home-hero__content > *:nth-child(2) { animation-delay: 0.12s; }
.rmh-home-hero__content > *:nth-child(3) { animation-delay: 0.19s; }
.rmh-home-hero__content > *:nth-child(4) { animation-delay: 0.26s; }
.rmh-home-hero__content > *:nth-child(5) { animation-delay: 0.33s; }

.rmh-hero-art {
    animation: rmh-scale-in 0.8s ease-out 0.15s backwards;
}

/* Delivery badge in hero */
.rmh-home-hero__delivery-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
