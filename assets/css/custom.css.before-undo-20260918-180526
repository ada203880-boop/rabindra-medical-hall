    margin-bottom: 12px;
}

.rmh-loc-result-card {
    padding: 16px;
    border: 1px solid #e4ece8;
    border-radius: 12px;
    background: #ffffff;
}

.rmh-loc-result-card--outside {
    background: #fffbf5;
}

.rmh-loc-distance-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f0faf5;
    color: #007a53;
    font-size: 0.82rem;
    font-weight: 750;
    margin-bottom: 10px;
}

.rmh-loc-result-title {
    margin: 0 0 8px;
    color: #10201b;
    font-size: 1.1rem;
    font-weight: 800;
}

.rmh-loc-result-desc {
    margin: 0;
    color: #5f716b;
    font-size: 0.88rem;
    line-height: 1.55;
}

.rmh-loc-disclaimer {
    margin: 12px 0 0;
}

.rmh-loc-disclaimer small {
    color: #5f716b;
    font-size: 0.78rem;
    line-height: 1.5;
}

.rmh-loc-secondary-action {
    display: flex;
    justify-content: center;
    margin-top: 12px;
}

.rmh-text-btn {
    background: transparent;
    border: 0;
    color: #007a53;
    font-size: 0.85rem;
    font-weight: 750;
    cursor: pointer;
    text-decoration: underline;
    padding: 8px 12px;
}

.rmh-text-btn:hover {
    color: #005f40;
}

.rmh-loc-error-box {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    border: 1px solid #f0c8ba;
    border-radius: 12px;
    background: #fff7f3;
}

.rmh-loc-error-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #fff0eb;
    color: #a84d37;
    font-size: 1.25rem;
}

.rmh-loc-error-box h4 {
    margin: 0 0 6px;
    color: #54251a;
    font-size: 1rem;
    font-weight: 800;
}

.rmh-loc-error-box p {
    margin: 0;
    color: #6f3526;
    font-size: 0.88rem;
    line-height: 1.55;
}

.rmh-manual-address-form {
    display: grid;
    gap: 14px;
}

.rmh-form-row {
    display: grid;
    gap: 14px;
}

.rmh-form-row--2col {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.rmh-form-row--3col {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.rmh-form-group {
    display: grid;
    gap: 6px;
}

.rmh-form-group label {
    color: #10201b;
    font-size: 0.88rem;
    font-weight: 750;
}

.rmh-req {
    color: #a21c1c;
}

.rmh-form-group input {
    width: 100%;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid #e4ece8;
    border-radius: 10px;
    background: #fbfdfc;
    color: #2d3748;
    font: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.rmh-form-group input:focus {
    border-color: rgba(0, 122, 83, 0.4);
    box-shadow: 0 0 0 3px rgba(0, 122, 83, 0.08);
    outline: none;
}

.rmh-form-feedback {
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
}

.rmh-form-feedback[hidden] {
    display: none;
}

.rmh-form-feedback.is-success {
    background: #eef8f4;
    color: #007a53;
}

.rmh-form-feedback.is-error {
