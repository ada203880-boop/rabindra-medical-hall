}

.rmh-btn-block {
    width: 100%;
    justify-content: center;
}

@media (max-width: 768px) {
    .rmh-modal-backdrop {
        padding: 16px;
        align-items: flex-end;
    }

    .rmh-location-modal {
        max-height: calc(100vh - 32px);
        border-radius: 20px 20px 0 0;
        transform: translateY(40px) scale(1);
    }

    .rmh-modal-backdrop.is-visible .rmh-location-modal {
        transform: translateY(0) scale(1);
    }

    .rmh-modal-header {
        padding: 16px 20px 0;
    }

    .rmh-modal-tabs {
        padding: 12px 20px 0;
    }

    .rmh-tab-panel {
        padding: 16px 20px 20px;
    }

    .rmh-form-row--2col,
    .rmh-form-row--3col {
        grid-template-columns: 1fr;
    }

    .rmh-loc-actions--dual {
        flex-direction: column;
    }
}

@media (prefers-reduced-motion: reduce) {
    .rmh-modal-backdrop,
    .rmh-location-modal,
    .rmh-tab-btn,
    .rmh-btn,
    .rmh-modal-close {
        transition-duration: 0.01ms !important;
    }
}

