    z-index: 998;
}

.rmh-site-header.is-menu-open .rmh-mobile-menu-scrim {
    opacity: 1;
    visibility: visible;
}

.rmh-site-header__nav-row {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s ease;
}

.rmh-site-header.is-menu-open .rmh-site-header__nav-row {
    max-height: 500px;
    padding-top: 16px;
}

/* Modern tooltip */
.rmh-tooltip {
    position: relative;
}

.rmh-tooltip::before {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    padding: 6px 12px;
    background: var(--rmh-ink);
    color: white;
    font-size: 0.72rem;
    font-weight: 650;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    pointer-events: none;
    z-index: 1000;
}

.rmh-tooltip:hover::before {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-8px);
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }

    .rmh-home-hero {
        animation: none;
    }

    .rmh-home-hero__content > * {
        animation: none;
    }

    .rmh-hero-art {
        animation: none;
    }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    .rmh-product-card,
    .rmh-category,
    .rmh-trust-item {
        border: 2px solid var(--rmh-ink);
    }

    .rmh-btn-primary {
        border: 2px solid var(--rmh-ink);
    }
}

/* Print styles */
@media print {
    .rmh-mobile-nav,
    .rmh-site-header,
    .rmh-hero-art,
    .rmh-promotion-carousel {
        display: none !important;
    }

    body {
        padding: 0;
        background: white;
    }

    .rmh-product-card,
    .rmh-category {
        break-inside: avoid;
        box-shadow: none;
        border: 1px solid #ddd;
    }
}

/* ==================================================
   DELIVERY LOCATION MODAL
   ================================================== */

.rmh-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 99998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.rmh-modal-backdrop.is-visible {
    opacity: 1;
    visibility: visible;
}

.rmh-location-modal {
    width: 100%;
    max-width: 560px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 24px 48px rgba(0, 78, 53, 0.18);
    transform: translateY(20px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.rmh-modal-backdrop.is-visible .rmh-location-modal {
    transform: translateY(0) scale(1);
}

.rmh-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px 0;
}

.rmh-modal-title-group {
    flex: 1 1 auto;
    min-width: 0;
}

.rmh-modal-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: #e8faf2;
    color: #007a53;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
}

.rmh-modal-header h2 {
    margin: 0;
    color: #10201b;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.2;
}

.rmh-modal-close {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e4ece8;
    border-radius: 10px;
    background: #ffffff;
    color: #5f716b;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.rmh-modal-close:hover {
    background: #f5f8f7;
    color: #007a53;
    border-color: #007a53;
}

.rmh-modal-tabs {
    display: flex;
    gap: 8px;
    padding: 16px 24px 0;
}

.rmh-tab-btn {
    flex: 1 1 auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    border: 1px solid #e4ece8;
    border-radius: 10px;
    background: #ffffff;
    color: #5f716b;
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s ease;
}

.rmh-tab-btn.is-active {
    background: #007a53;
    color: #ffffff;
    border-color: #007a53;
}

.rmh-tab-btn:hover:not(.is-active) {
    border-color: #007a53;
    color: #007a53;
}

.rmh-tab-panel {
    display: none;
    padding: 20px 24px 24px;
}

.rmh-tab-panel.is-active {
    display: block;
}

.rmh-loc-state {
    display: none;
}

.rmh-loc-state.is-active {
    display: block;
}

.rmh-loc-card-hero {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: flex-start;
    padding: 16px;
    border: 1px solid #e4ece8;
    border-radius: 14px;
    background: #f5fbf7;
    margin-bottom: 16px;
}

.rmh-loc-hero-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: #e8faf2;
    color: #007a53;
    font-size: 1.5rem;
}

.rmh-loc-hero-text h3 {
    margin: 0 0 6px;
    color: #10201b;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.3;
}

.rmh-loc-hero-text p {
    margin: 0;
    color: #5f716b;
    font-size: 0.88rem;
    line-height: 1.55;
}

.rmh-loc-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
}

.rmh-loc-actions--dual {
    flex-direction: row;
}

.rmh-loc-actions--dual .rmh-btn {
    flex: 1 1 auto;
}

.rmh-loc-privacy-note {
    margin: 12px 0 0;
    color: #5f716b;
    font-size: 0.78rem;
    line-height: 1.5;
}

.rmh-loc-spinner {
    width: 40px;
    height: 40px;
    margin: 0 auto 16px;
    border: 3px solid #e4ece8;
    border-top-color: #007a53;
    border-radius: 50%;
    animation: rmh-spin 0.8s linear infinite;
}

.rmh-loc-loading-title {
    margin: 0 0 6px;
    color: #10201b;
    font-size: 1.05rem;
    font-weight: 800;
    text-align: center;
}

.rmh-loc-loading-desc {
    margin: 0;
    color: #5f716b;
    font-size: 0.88rem;
    text-align: center;
}

.rmh-loc-badge-success {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #e8faf2;
    color: #007a53;
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 12px;
}

.rmh-loc-badge-warning {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff8e5;
    color: #825b00;
    font-size: 0.85rem;
