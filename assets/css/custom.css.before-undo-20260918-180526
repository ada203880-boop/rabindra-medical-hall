/*
Theme foundation for Rabindra Medical Hall.

Detailed homepage styling currently lives in WordPress Additional CSS while the
existing page design is preserved. This file intentionally contains only safe
site-wide foundations and WooCommerce polish so it does not fight Astra's
responsive header or duplicate the homepage hero styles.
*/

:root {
    --rmh-green: #007a48;
    --rmh-green-dark: #005f40;
    --rmh-mint: #00c853;
    --rmh-ink: #2d3748;
    --rmh-muted: #5f716b;
    --rmh-border: #dfe9e5;
    --rmh-soft: #f5f8f7;
    --rmh-white: #ffffff;
}

html,
body {
    max-width: 100%;
    overflow-x: hidden;
}

body {
    color: var(--rmh-ink);
}

a {
    text-underline-offset: 0.18em;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
.button:focus-visible,
.ast-button:focus-visible {
    outline: 3px solid rgba(0, 122, 83, 0.32);
    outline-offset: 3px;
}

.site-header,
.ast-primary-header-bar {
    border-bottom-color: var(--rmh-border);
}

.site-title a,
.main-header-menu .menu-link,
.ast-header-account-link,
.ast-site-header-cart a {
    color: var(--rmh-ink);
}

.main-header-menu .menu-link:hover,
.main-header-menu .current-menu-item > .menu-link,
.ast-site-header-cart a:hover {
    color: var(--rmh-green);
}

.ast-site-header-cart .ast-addon-cart-wrap i.astra-icon::after,
.ast-site-header-cart .ast-woo-header-cart-info-wrap {
    color: var(--rmh-green);
}

.rmh-site-header {
    position: sticky;
    top: 0;
    z-index: 99;
    width: 100%;
    border-bottom: 1px solid var(--rmh-border);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 6px 24px rgba(0, 78, 53, 0.06);
    backdrop-filter: blur(12px);
}

.rmh-site-header__inner {
    max-width: 1240px;
    min-height: 56px;
    margin: 0 auto;
    padding: 6px 24px;
    display: grid;
    grid-template-columns: auto minmax(220px, 420px) 1fr auto;
    align-items: center;
    gap: 14px;
}

.rmh-site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    color: var(--rmh-ink);
    text-decoration: none;
}

.rmh-site-header__mark {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(0, 122, 83, 0.18);
}

.rmh-site-header__brand-text {
    display: grid;
    gap: 2px;
    min-width: 0;
}

.rmh-site-header__name {
    color: var(--rmh-ink);
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
}

.rmh-site-header__tagline {
    color: var(--rmh-muted);
    font-size: 0.68rem;
    line-height: 1.2;
    white-space: nowrap;
}

.rmh-site-search-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 auto;
}

.rmh-header-loc-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--rmh-border);
    border-radius: 9px;
    background: #ffffff;
    color: var(--rmh-ink);
    font-size: 0.78rem;
    font-weight: 750;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
}

.rmh-header-loc-icon {
    font-size: 0.9rem;
}

.rmh-header-loc-text small {
    display: block;
    font-size: 0.66rem;
    color: var(--rmh-muted);
    line-height: 1.2;
}

.rmh-header-loc-text strong {
    font-size: 0.78rem;
    line-height: 1.2;
}

.rmh-header-loc-chevron {
    font-size: 0.7rem;
    color: var(--rmh-muted);
}

.rmh-site-search {
    min-width: 0;
    height: 44px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--rmh-border);
    border-radius: 9px;
    background: #f8fbfa;
    flex: 1 1 auto;
}

.rmh-site-search input[type="search"] {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0 13px;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: var(--rmh-ink);
    font-size: 0.88rem;
}

.rmh-site-search button[type="submit"] {
    align-self: stretch;
    min-width: 82px;
    padding: 0 16px;
    border: 0;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
    flex-shrink: 0;
}

.rmh-site-search button[type="submit"]:hover {
    background: var(--rmh-green-dark);
}

.rmh-search-input-wrap {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    gap: 8px;
    padding: 0 4px 0 12px;
}

.rmh-search-lens {
    font-size: 0.9rem;
    opacity: 0.7;
    flex-shrink: 0;
}

.rmh-search-clear {
    background: none;
    border: 0;
    color: var(--rmh-muted);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 4px;
    line-height: 1;
}

.rmh-search-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--rmh-border);
    border-top-color: var(--rmh-green);
    border-radius: 50%;
    animation: rmh-spin 0.6s linear infinite;
}

@keyframes rmh-spin {
    to {
        transform: rotate(360deg);
    }
}

.rmh-search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 320px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid var(--rmh-border);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    z-index: 1000;
}

.rmh-search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--rmh-border);
    text-decoration: none;
    color: inherit;
}

.rmh-search-item:last-child {
    border-bottom: 0;
}

.rmh-search-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: #f8f9fa;
}

.rmh-search-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 750;
}

.rmh-btn-search-add,
.rmh-btn-search-view {
    min-height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 750;
    cursor: pointer;
    flex-shrink: 0;
}

.rmh-btn-search-add {
    background: var(--rmh-green);
    color: #ffffff;
    border: 0;
}

.rmh-btn-search-view {
    background: #ffffff;
    color: var(--rmh-ink);
    border: 1px solid var(--rmh-border);
}

.rmh-site-nav {
    justify-self: end;
}

.rmh-site-nav__menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.rmh-site-nav__menu a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 0 11px;
    border-radius: 8px;
    color: var(--rmh-ink);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
}

.rmh-site-nav__menu a:hover,
.rmh-site-nav__menu .current-menu-item > a {
    background: #eef8f4;
    color: var(--rmh-green);
}

.rmh-site-header__actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
}

.rmh-site-header__action,
.rmh-site-header__cart {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--rmh-border);
    border-radius: 9px;
    color: var(--rmh-ink);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
    background: var(--rmh-white);
}

.rmh-site-header__cart {
    border-color: rgba(0, 122, 83, 0.18);
    color: var(--rmh-green);
}

.rmh-cart-count {
    min-width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-size: 0.7rem;
    line-height: 1;
}

.rmh-menu-toggle {
    width: 44px;
    height: 44px;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    border: 1px solid var(--rmh-border);
    border-radius: 9px;
    background: var(--rmh-white);
    cursor: pointer;
}

.rmh-menu-toggle span[aria-hidden="true"] {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--rmh-ink);
}

.rmh-js .rmh-site-header.is-menu-open .rmh-menu-toggle span[aria-hidden="true"]:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
}

.rmh-js .rmh-site-header.is-menu-open .rmh-menu-toggle span[aria-hidden="true"]:nth-child(3) {
    opacity: 0;
}

.rmh-js .rmh-site-header.is-menu-open .rmh-menu-toggle span[aria-hidden="true"]:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
}

.rmh-empty-state {
    padding: 28px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-white);
    color: var(--rmh-muted);
    text-align: center;
    box-shadow: 0 10px 28px rgba(0, 78, 53, 0.05);
}

.rmh-empty-state h3 {
    margin: 0 0 8px;
    color: var(--rmh-ink);
    font-size: 1.1rem;
}

.rmh-empty-state p {
    max-width: 680px;
    margin: 0 auto 18px;
    color: var(--rmh-muted);
}

.rmh-category-grid .rmh-category-icon {
    width: auto;
    min-width: 64px;
    padding: 0 10px;
    font-size: 0.75rem;
    font-weight: 800;
}

.rmh-category-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 100%;
}

.rmh-category {
    min-width: 0;
    min-height: 192px;
    display: grid;
    align-content: start;
    gap: 9px;
    padding: 14px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-white);
    color: var(--rmh-ink);
    box-shadow: 0 8px 22px rgba(0, 78, 53, 0.05);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.rmh-category:hover {
    border-color: rgba(0, 122, 83, 0.3);
    color: var(--rmh-ink);
    box-shadow: 0 12px 26px rgba(0, 78, 53, 0.1);
    transform: translateY(-2px);
}

.rmh-category:focus-visible {
    color: var(--rmh-ink);
}

.rmh-category-media {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 10px;
    background: #eef8f4;
    color: var(--rmh-green);
}

.rmh-category-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.rmh-category-art {
    width: 100%;
    height: 100%;
    display: block;
}

.rmh-category-media .rmh-category-icon {
    min-width: 0;
    padding: 0;
    color: var(--rmh-green);
    font-size: 1.05rem;
    font-weight: 850;
}

.rmh-category strong {
    overflow-wrap: anywhere;
    color: var(--rmh-ink);
    font-size: 0.92rem;
    line-height: 1.25;
}

.rmh-category > span:last-child {
    color: var(--rmh-muted);
    font-size: 0.76rem;
    line-height: 1.2;
}

.rmh-category-grid__footer {
    display: flex;
    justify-content: center;
    margin-top: 20px;
}

.rmh-promotion-section {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto 36px;
    padding: 0 24px;
    box-sizing: border-box;
}

.rmh-promotion-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.rmh-promotion-banner {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    box-sizing: border-box;
}

.rmh-promotion-banner__content {
    position: relative;
    z-index: 1;
    max-width: 82%;
}

.rmh-promotion-banner h2 {
    margin: 0 0 9px;
    color: var(--rmh-ink);
    font-size: 1.35rem;
    line-height: 1.15;
}

.rmh-promotion-banner p {
    min-height: 50px;
    margin: 0 0 18px;
    color: var(--rmh-muted);
    font-size: 0.9rem;
    line-height: 1.55;
}

.rmh-promotion-banner__mark {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 86px;
    height: 86px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.05rem;
    font-weight: 850;
    opacity: 0.85;
}

.rmh-promotion-banner--green {
    background: #effaf5;
}

.rmh-promotion-banner--green .rmh-promotion-banner__mark {
    background: #ccefe0;
    color: var(--rmh-green-dark);
}

.rmh-promotion-banner--blue {
    background: #eff7fb;
}

.rmh-promotion-banner--blue .rmh-promotion-banner__mark {
    background: #d5ebf6;
    color: #17627c;
}

.rmh-promotion-banner--coral {
    background: #fff4ef;
}

.rmh-promotion-banner--coral .rmh-promotion-banner__mark {
    background: #f8ded3;
    color: #a84d37;
}

.rmh-prescription-checkout-notice {
    margin: 0 0 20px;
    padding: 14px 16px;
    border: 1px solid #f0c8ba;
    border-radius: 8px;
    background: #fff7f3;
    color: #6f3526;
    line-height: 1.5;
}

.rmh-prescription-checkout-notice strong {
    color: #54251a;
}

.rmh-prescription-checkout-notice a {
    color: #8c3f2a;
    font-weight: 800;
}

.rmh-prescription-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: #fff0eb;
    color: #a84d37;
    font-size: 0.7rem;
    font-weight: 800;
}

.rmh-buy-now {
    margin-left: 6px !important;
    background: #eaf5f1 !important;
    color: var(--rmh-green-dark) !important;
}

.rmh-buy-now:hover {
    background: #d8eee6 !important;
    color: var(--rmh-green-dark) !important;
}

.rmh-shop-tools {
    margin: 0 0 28px;
    padding: 20px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-soft);
}

.rmh-shop-tools__search {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
}

.rmh-shop-tools__search input[type="search"] {
    min-height: 46px;
    flex: 1 1 auto;
    min-width: 0;
    border-color: var(--rmh-border);
    border-radius: 8px;
}

.rmh-shop-tools__search button {
    min-height: 46px;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-weight: 750;
}

.rmh-shop-tools__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.rmh-shop-tools__categories a {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid var(--rmh-border);
    border-radius: 999px;
    background: var(--rmh-white);
    color: var(--rmh-ink);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
}

.rmh-shop-tools__categories a:hover {
    border-color: rgba(0, 122, 83, 0.32);
    color: var(--rmh-green);
}

.rmh-section-label {
    display: inline-flex;
    margin-bottom: 10px;
    color: var(--rmh-green);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.rmh-section-label--pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background: #e8faf2;
    color: #007a53;
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    margin-bottom: 10px;
}

.rmh-faq-section {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto 28px;
    padding: 0 24px;
    box-sizing: border-box;
}

.rmh-faq-section__header {
    margin-bottom: 14px;
}

.rmh-faq-section__header h2 {
    margin: 0 0 6px;
    color: var(--rmh-ink);
    font-size: 1.45rem;
    line-height: 1.2;
}

.rmh-faq-section__header p {
    margin: 0;
    color: var(--rmh-muted);
}

.rmh-faq-list {
    display: grid;
    gap: 10px;
}

.rmh-faq-list details {
    border: 1px solid var(--rmh-border);
    border-radius: 10px;
    background: var(--rmh-white);
}

.rmh-faq-list summary {
    padding: 16px 18px;
    color: var(--rmh-ink);
    font-weight: 800;
    cursor: pointer;
}

.rmh-faq-list details p {
    margin: 0;
    padding: 0 18px 16px;
    color: var(--rmh-muted);
    line-height: 1.65;
}

.rmh-footer-information {
    border-top: 1px solid var(--rmh-border);
    background: var(--rmh-soft);
}

.rmh-footer-information__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.rmh-footer-information__inner strong {
    color: var(--rmh-ink);
    font-size: 0.88rem;
}

.rmh-footer-information nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 14px;
}

.rmh-footer-information nav a {
    color: var(--rmh-muted);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
}

.rmh-footer-information nav a:hover {
    color: var(--rmh-green);
}

.rmh-page-hero {
    max-width: 1120px;
    margin: 32px auto 36px;
    padding: 52px 32px;
    border: 1px solid var(--rmh-border);
    border-radius: 16px;
    background: linear-gradient(135deg, #eefaf6 0%, #ffffff 100%);
    box-shadow: 0 12px 36px rgba(0, 78, 53, 0.06);
}

.rmh-360-showcase,
.rmh-find-store {
    max-width: 1120px;
    margin: 0 auto 36px;
    padding: 28px 24px;
    border: 1px solid var(--rmh-border);
    border-radius: 18px;
    background: linear-gradient(135deg, #f3faf7 0%, #ffffff 100%);
    box-shadow: 0 14px 34px rgba(0, 78, 53, 0.06);
}

.rmh-360-showcase {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: center;
}

.rmh-360-showcase__visual {
    position: relative;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: radial-gradient(circle at center, rgba(0, 122, 83, 0.18), rgba(0, 122, 83, 0.05) 40%, rgba(255, 255, 255, 0) 72%);
    overflow: hidden;
}

.rmh-360-orbit {
    position: absolute;
    border: 1px solid rgba(0, 122, 83, 0.22);
    border-radius: 50%;
}

.rmh-360-orbit--one {
    width: 200px;
    height: 200px;
}

.rmh-360-orbit--two {
    width: 150px;
    height: 150px;
    transform: rotate(20deg);
}

.rmh-360-core {
    position: relative;
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(var(--rmh-view-rotation, 0deg));
    transition: transform 0.35s ease;
}

.rmh-360-bottle {
    position: relative;
    width: 88px;
    height: 110px;
    border-radius: 18px 18px 16px 16px;
    background: linear-gradient(180deg, #1f5f4e 0%, #0b4537 100%);
    box-shadow: 0 12px 24px rgba(0, 78, 53, 0.2);
}

.rmh-360-bottle::before {
    content: "";
    position: absolute;
    inset: -14px auto auto 50%;
    width: 32px;
    height: 14px;
    transform: translateX(-50%);
    border-radius: 8px 8px 0 0;
    background: #dff3eb;
}

.rmh-360-pill {
    position: absolute;
    width: 70px;
    height: 20px;
    border-radius: 999px;
    background: rgba(0, 122, 83, 0.14);
    box-shadow: inset 0 0 0 1px rgba(0, 122, 83, 0.1);
}

.rmh-360-pill--one { transform: rotate(28deg) translateX(78px); }
.rmh-360-pill--two { transform: rotate(-32deg) translateX(-78px); }
.rmh-360-pill--three { transform: rotate(90deg) translateY(-90px); }

.rmh-360-glow {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 122, 83, 0.12), rgba(0, 122, 83, 0.02) 55%, rgba(0, 122, 83, 0) 72%);
}

.rmh-360-showcase__content h2,
.rmh-find-store__header h2 {
    margin: 0 0 14px;
    color: var(--rmh-ink);
    font-size: clamp(1.8rem, 2.6vw, 2.7rem);
    line-height: 1.15;
}

.rmh-360-showcase__content p,
.rmh-find-store__address {
    margin: 0;
    color: var(--rmh-muted);
    line-height: 1.7;
}

.rmh-360-showcase__controls,
.rmh-360-showcase__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    flex-wrap: wrap;
}

.rmh-360-control {
    width: 42px;
    height: 42px;
    border: 1px solid var(--rmh-border);
    border-radius: 50%;
    background: var(--rmh-white);
    color: var(--rmh-ink);
    font-size: 1.25rem;
    cursor: pointer;
}

.rmh-360-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: #eafaf2;
    color: var(--rmh-green);
    font-size: 0.82rem;
    font-weight: 800;
}

.rmh-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 10px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.rmh-btn:hover {
    transform: translateY(-1px);
}

.rmh-btn-primary {
    border: 1px solid rgba(0, 122, 83, 0.14);
    background: var(--rmh-green);
    color: var(--rmh-white);
    box-shadow: 0 10px 18px rgba(0, 122, 83, 0.18);
}

.rmh-btn-primary:hover {
    background: var(--rmh-green-dark);
    color: var(--rmh-white);
}

.rmh-btn-secondary {
    border: 1px solid var(--rmh-border);
    background: var(--rmh-white);
    color: var(--rmh-ink);
}

.rmh-find-store {
    display: grid;
    gap: 12px;
}

.rmh-find-store__subtitle {
    margin: 0;
    color: var(--rmh-muted);
    font-size: 0.95rem;
    line-height: 1.55;
}

.rmh-find-store__address-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: #ffffff;
}

.rmh-find-store__addr-icon {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
}

.rmh-find-store__addr-text {
    min-width: 0;
}

.rmh-find-store__addr-text strong {
    display: block;
    margin: 0 0 4px;
    color: var(--rmh-ink);
    font-size: 0.95rem;
    font-weight: 800;
}

.rmh-find-store__addr-text address {
    margin: 0;
    color: var(--rmh-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    font-style: normal;
}

.rmh-find-store__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.rmh-find-store__directions-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.rmh-find-store__directions-btn svg {
    flex-shrink: 0;
}

.rmh-payment-empty {
    margin-top: 14px;
    padding: 18px 20px;
    border: 1px dashed rgba(0, 122, 83, 0.28);
    border-radius: 12px;
    background: #f6fbf8;
    color: var(--rmh-muted);
}

.rmh-payment-empty h3 {
    margin: 0 0 8px;
    color: var(--rmh-ink);
    font-size: 1rem;
}

.rmh-payment-empty p {
    margin: 0;
    line-height: 1.6;
}

.rmh-account-prescriptions {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--rmh-border);
}

.rmh-account-prescriptions h2 {
    margin: 0 0 14px;
    color: var(--rmh-ink);
    font-size: 1.25rem;
}

.rmh-account-prescriptions .rmh-empty-state {
    margin: 0;
}

.rmh-account-prescriptions__list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.rmh-account-prescriptions__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--rmh-border);
    border-radius: 8px;
    background: var(--rmh-soft);
}

.rmh-account-prescriptions__item span {
    color: var(--rmh-muted);
    font-size: 0.9rem;
}

.rmh-order-prescription-link {
    margin: 20px 0 0;
}

@media (max-width: 600px) {
    .rmh-cart-contact-actions {
        grid-template-columns: 1fr;
    }

    .rmh-account-prescriptions__item {
        grid-template-columns: 1fr;
        gap: 6px;
    }
}

.rmh-page-kicker {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--rmh-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
}

.rmh-page-hero h1 {
    max-width: 780px;
    margin: 0 0 14px;
    color: var(--rmh-ink);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.05;
}

.rmh-page-hero p {
    max-width: 780px;
    margin: 0;
    color: var(--rmh-muted);
    font-size: 1.05rem;
    line-height: 1.7;
}

.rmh-content-section,
.rmh-feature-band {
    max-width: 1120px;
    margin: 0 auto 36px;
    padding: 0 24px;
}

.rmh-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: 28px;
    align-items: start;
}

.rmh-content-grid article,
.rmh-highlight-panel,
.rmh-feature-band article {
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-white);
    box-shadow: 0 10px 28px rgba(0, 78, 53, 0.05);
}

.rmh-content-grid article {
    padding: 28px;
}

.rmh-content-grid h2,
.rmh-feature-band h2 {
    margin: 0 0 12px;
    color: var(--rmh-ink);
    font-size: 1.35rem;
}

.rmh-content-grid p,
.rmh-feature-band p {
    margin: 0;
    color: var(--rmh-muted);
    line-height: 1.7;
}

.rmh-highlight-panel {
    padding: 24px;
}

.rmh-highlight-panel strong {
    display: block;
    margin-bottom: 12px;
    color: var(--rmh-ink);
    font-size: 1rem;
}

.rmh-highlight-panel ul {
    margin: 0;
    padding-left: 20px;
    color: var(--rmh-muted);
}

.rmh-highlight-panel li + li {
    margin-top: 8px;
}

.rmh-feature-band {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.rmh-feature-band article {
    padding: 24px;
}

.rmh-contact-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: start;
}

.rmh-contact-panel,
.rmh-form-card {
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-white);
    box-shadow: 0 10px 28px rgba(0, 78, 53, 0.05);
}

.rmh-contact-panel {
    padding: 26px;
}

.rmh-contact-panel h2 {
    margin: 0 0 14px;
    color: var(--rmh-ink);
    font-size: 1.28rem;
}

.rmh-muted-note {
    color: var(--rmh-muted);
    font-size: 0.92rem;
}

.rmh-form-card {
    padding: 24px;
    border: 1px solid var(--rmh-border);
    background: var(--rmh-white);
    box-shadow: 0 10px 28px rgba(0, 78, 53, 0.05);
}

.rmh-pharmacy-form {
    display: grid;
    gap: 16px;
    margin: 0;
}

.rmh-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.rmh-field-help {
    color: var(--rmh-muted);
    font-size: 0.82rem;
    line-height: 1.5;
}

.rmh-secure-form {
    display: grid;
    gap: 16px;
}

.rmh-form-field {
    display: grid;
    gap: 7px;
}

.rmh-form-field label {
    color: var(--rmh-ink);
    font-size: 0.9rem;
    font-weight: 750;
}

.rmh-form-field input,
.rmh-form-field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--rmh-border);
    border-radius: 8px;
    background: #fbfdfc;
    color: var(--rmh-ink);
    font: inherit;
    box-sizing: border-box;
}

.rmh-form-field input {
    min-height: 44px;
}

.rmh-form-field textarea {
    min-height: 120px;
    resize: vertical;
}

.rmh-prescription-file-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.rmh-file-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid var(--rmh-border);
    border-radius: 8px;
    background: var(--rmh-soft);
    color: var(--rmh-ink);
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
}

.rmh-file-action:hover {
    border-color: var(--rmh-green);
    color: var(--rmh-green-dark);
}

.rmh-prescription-file-input {
    max-width: 100%;
}

.rmh-camera-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
}

.rmh-file-status {
    min-height: 1.3em;
    color: var(--rmh-muted);
    font-size: 0.84rem;
}

.rmh-form-submit,
.rmh-form-button {
    min-height: 46px;
    border: 0;
    border-radius: 8px;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
}

.rmh-form-submit:hover,
.rmh-form-button:hover {
    background: var(--rmh-green-dark);
    transform: translateY(-1px);
}

.rmh-form-submit:hover {
    background: var(--rmh-green-dark);
}

.rmh-whatsapp-button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 18px;
    border-radius: 8px;
    background: #128c4a;
    color: var(--rmh-white);
    font-weight: 800;
    text-decoration: none;
}

.rmh-whatsapp-button:hover {
    background: #0d703a;
    color: var(--rmh-white);
}

.rmh-whatsapp-button--cart {
    width: 100%;
    margin-top: 10px;
}

.rmh-cart-contact-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.rmh-cart-contact-actions .rmh-whatsapp-button--cart,
.rmh-cart-contact-actions .rmh-phone-button--cart {
    width: 100%;
    margin-top: 10px;
    box-sizing: border-box;
}

.rmh-phone-button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--rmh-ink);
    color: var(--rmh-white);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
}

.rmh-phone-button:hover {
    background: #253d35;
    color: var(--rmh-white);
}

.rmh-phone-button strong {
    white-space: nowrap;
}

.rmh-form-button:disabled {
    cursor: wait;
    opacity: 0.7;
}

.rmh-cart-whatsapp-note {
    margin: 10px 0 0;
    color: var(--rmh-muted);
    font-size: 0.84rem;
    line-height: 1.5;
}

.rmh-form-notice {
    margin-bottom: 16px;
    padding: 12px 14px;
    border-radius: 8px;
    font-weight: 700;
}

.rmh-form-notice--success {
    background: #eef8f4;
    color: var(--rmh-green);
}

.rmh-form-notice--error {
    background: #fff1f1;
    color: #a21c1c;
}

.rmh-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
}

.rmh-loop-pack-size {
    margin: 0 0 8px;
    color: var(--rmh-muted);
    font-size: 0.84rem;
}

.rmh-loop-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0;
}

.rmh-stock-badge,
.rmh-discount-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 750;
}

.rmh-stock-badge {
    background: #eef8f4;
    color: var(--rmh-green);
}

.rmh-stock-badge--outofstock {
    background: #fff1f1;
    color: #a21c1c;
}

.rmh-stock-badge--onbackorder {
    background: #fff8e5;
    color: #825b00;
}

.rmh-discount-badge {
    background: #f1f5ff;
    color: #2450a6;
}

.rmh-product-information {
    clear: both;
    margin-top: 28px;
    padding: 22px;
    border: 1px solid var(--rmh-border);
    border-radius: 12px;
    background: var(--rmh-white);
}

.rmh-product-information h2 {
    margin: 0 0 16px;
    color: var(--rmh-ink);
    font-size: 1.2rem;
}

.rmh-product-information dl {
    display: grid;
    gap: 0;
    margin: 0;
}

.rmh-product-information dl > div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--rmh-border);
}

.rmh-product-information dt {
    color: var(--rmh-muted);
    font-weight: 750;
}

.rmh-product-information dd {
    margin: 0;
    color: var(--rmh-ink);
}

.woocommerce ul.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
}

.woocommerce ul.products::before,
.woocommerce ul.products::after {
    display: none;
}

.woocommerce ul.products li.product {
    width: auto;
    margin: 0;
    padding: 18px;
    border: 1px solid var(--rmh-border);
    border-radius: 10px;
    background: var(--rmh-white);
    box-shadow: 0 10px 28px rgba(0, 78, 53, 0.05);
}

.woocommerce ul.products li.product .woocommerce-loop-product__title {
    color: var(--rmh-ink);
    font-size: 1rem;
    line-height: 1.35;
}

.woocommerce ul.products li.product .price,
.woocommerce div.product p.price,
.woocommerce div.product span.price {
    color: var(--rmh-green);
    font-weight: 800;
}

.woocommerce a.button,
.woocommerce button.button,
.woocommerce input.button,
.woocommerce #respond input#submit,
.woocommerce div.product form.cart .button {
    min-height: 44px;
    border-radius: 8px;
    background: var(--rmh-green);
    color: var(--rmh-white);
    font-weight: 700;
}

.woocommerce a.button:hover,
.woocommerce button.button:hover,
.woocommerce input.button:hover,
.woocommerce #respond input#submit:hover,
.woocommerce div.product form.cart .button:hover {
    background: var(--rmh-green-dark);
    color: var(--rmh-white);
}

.woocommerce-notices-wrapper,
.woocommerce-message,
.woocommerce-info,
.woocommerce-error {
    border-radius: 8px;
}

.woocommerce table.shop_table,
.woocommerce-cart-form,
.cart_totals,
.woocommerce-checkout-review-order {
    border-radius: 10px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}

@media (max-width: 1100px) {
    .rmh-site-header__inner {
        grid-template-columns: auto 1fr auto auto;
    }

    .rmh-menu-toggle {
        display: inline-flex;
        order: 4;
    }

    .rmh-site-nav {
        grid-column: 1 / -1;
        width: 100%;
        display: none;
    }

    .rmh-site-header.is-menu-open .rmh-site-nav {
        display: block;
    }

    .rmh-site-nav__menu {
        align-items: stretch;
        justify-content: flex-start;
        flex-direction: column;
        gap: 6px;
        padding: 10px 0 4px;
    }

    .rmh-site-nav__menu a {
        width: 100%;
        justify-content: flex-start;
        padding: 0 12px;
    }

    .rmh-category-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}

@media (max-width: 900px) and (min-width: 769px) {
    .rmh-category-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .rmh-promotion-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rmh-promotion-banner:last-child {
        grid-column: 1 / -1;
    }
}

@media (max-width: 782px) {
    .admin-bar .rmh-site-header {
        top: 46px;
    }
}

@media (max-width: 768px) {
    .rmh-site-header__inner {
        min-height: auto;
        grid-template-columns: 1fr auto auto;
        gap: 10px;
        padding: 10px 16px;
    }

    .rmh-site-search {
        grid-column: 1 / -1;
        grid-row: 2;
        max-width: none;
    }

    .rmh-site-header__tagline,
    .rmh-site-header__action {
        display: none;
    }

    .rmh-form-card {
        padding: 18px;
    }

    .rmh-site-header__name {
        max-width: 190px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rmh-site-header__cart {
        min-width: 44px;
        padding: 0 9px;
    }

    .rmh-shop-tools {
        padding: 14px;
    }

    .rmh-shop-tools__search {
        flex-direction: column;
    }

    .rmh-shop-tools__search button {
        width: 100%;
    }

    .rmh-category-grid {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding: 0 2px 8px;
        scroll-snap-type: x proximity;
        scrollbar-width: thin;
    }

    .rmh-category {
        flex: 0 0 150px;
        min-height: 184px;
        scroll-snap-align: start;
    }

    .rmh-category-grid__footer {
        margin-top: 16px;
    }

    .rmh-promotion-section {
        margin-bottom: 28px;
        padding: 0 16px;
    }

    .rmh-faq-section {
        margin-bottom: 28px;
        padding: 0 16px;
    }

    .rmh-footer-information__inner {
        align-items: flex-start;
        flex-direction: column;
        padding: 18px 16px;
    }

    .rmh-footer-information nav {
        justify-content: flex-start;
    }

    .rmh-promotion-grid {
        grid-template-columns: 1fr;
    }

    .rmh-promotion-banner {
        min-height: 210px;
        padding: 20px;
    }

    .rmh-promotion-banner__content {
        max-width: 76%;
    }

    .rmh-promotion-banner h2 {
        font-size: 1.2rem;
    }

    .rmh-promotion-banner p {
        min-height: 0;
    }

    .rmh-product-information dl > div {
        grid-template-columns: 1fr;
        gap: 4px;
    }

    .rmh-page-hero,
    .rmh-360-showcase,
    .rmh-find-store {
        margin: 20px 16px 28px;
        padding: 24px 18px;
    }

    .rmh-360-showcase {
        grid-template-columns: 1fr;
    }

    .rmh-content-grid,
    .rmh-contact-grid,
    .rmh-feature-band {
        grid-template-columns: 1fr;
    }

    .rmh-form-grid {
        grid-template-columns: 1fr;
    }

    .woocommerce ul.products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .woocommerce ul.products li.product {
        padding: 12px;
    }

    .woocommerce ul.products li.product .button {
        width: 100%;
        padding-right: 10px;
        padding-left: 10px;
        text-align: center;
    }

    .rmh-product-footer .rmh-buy-now {
        width: 100%;
        margin-top: 6px;
        margin-left: 0 !important;
    }
}

@media (min-width: 421px) and (max-width: 768px) {
    .rmh-home-hero {
        width: calc(100% - 36px);
    }
}

@media (max-width: 420px) {
    .rmh-site-header__mark {
        width: 38px;
